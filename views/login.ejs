<%- include('partials/head') %>
<section class="section section-shell">
  <div class="container">
    <% if (flash) { %>
      <div class="notification <%= flash.type %>"><%= flash.message %></div>
    <% } %>
    <div class="columns is-centered">
      <div class="column is-5">
        <div class="card page-card">
          <div class="card-content">
            <p class="title is-4">Login</p>
            <p class="subtitle is-6">Entre como instrutor ou aluno com seu email e senha.</p>
            <form method="post" action="/login">
              <div class="field">
                <label class="label">Email</label>
                <div class="control">
                  <input class="input" type="email" name="email" required />
                </div>
              </div>
              <div class="field">
                <label class="label">Senha</label>
                <div class="control">
                  <input class="input" type="password" name="password" required />
                </div>
              </div>
              <div class="field">
                <div class="control">
                  <button class="button is-link is-fullwidth" type="submit">Entrar</button>
                </div>
              </div>
            </form>
            <p class="footer-note mt-4">Se ainda não houver instrutor cadastrado, use a tela de criação do primeiro instrutor.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('partials/foot') %>